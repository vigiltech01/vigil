# Copy to .env and adjust (all optional). docker compose reads it automatically.

# Web UI port on this machine
VIGIL_HTTP_PORT=8080
# Syslog port on this machine (the FortiGate sends here). 514 needs no FortiGate change; any port works.
VIGIL_SYSLOG_PORT=514
# Only accept syslog from these senders (comma separated IPs/CIDRs). Empty = accept from anyone.
VIGIL_SYSLOG_ALLOW=
# Days of detailed logs to keep (summaries are kept longer)
VIGIL_RETENTION_DAYS=30
# Memory limit for the container
VIGIL_MEM_LIMIT=4g
# 1 = generate a fictional firewall's traffic so you can explore Vigil without a FortiGate
VIGIL_DEMO=0
# Optional: create the admin account automatically instead of using the first-run page
# VIGIL_ADMIN_USER=admin
# VIGIL_ADMIN_PASSWORD=

# ---- where FortiGate logs come from (./install.sh sets these automatically) ----
# receiver = Vigil's built-in syslog receiver on VIGIL_SYSLOG_PORT (default)
# file     = this machine already receives the FortiGate with its own syslog server (rsyslog, syslog-ng) on port 514;
#            Vigil reads that server's file read-only and never changes it. VIGIL_SYSLOG_PORT must then be another port.
VIGIL_INPUT=receiver
# file input only: directory and name of the syslog file on this machine, e.g. /var/log + syslog
# VIGIL_HOST_LOG_DIR=/var/log
# VIGIL_LOG_NAME=syslog
# group that may read the file (adm = 4 on Debian/Ubuntu)
# VIGIL_HOST_LOG_GID=4
# port the existing syslog server listens on (shown in the setup page)
# VIGIL_HOST_SYSLOG_PORT=514
# first start: skip rotated log files older than this many days (default 1 for file input, 0 = read everything)
# VIGIL_BACKFILL_DAYS=1
